  "title": "キャッシュの話",
  "cast": [
    "metan",
    "zundamon"
  ],
  "speed": 1.05,
  "pauses": {
    "turn": 0.3
  },
  "chapters": [
    {
      "id": "c1",
      "title": "なぜ速くなるのか",
      "lines": [
        {
          "who": "zundamon",
          "text": "めたん、同じ計算を何度もすると遅いのだ。"
        },
        {
          "who": "metan",
          "text": "それなら、一度計算した結果を取っておけばいいのよ。"
        },
        {
          "text": "これがキャッシュ。二回目からは保存した結果を返すだけになるわ。"
        },
        {
          "who": "zundamon",
          "text": "計算しないから速いのだ！"
        }
      ]
    },
    {
      "id": "c2",
      "title": "気をつけること",
      "lines": [
        {
          "who": "metan",
          "text": "ただし、元のデータが変わったら困るわね。"
        },
        {
          "who": "zundamon",
          "text": "古い結果を返してしまうのだ。"
        },
        {
          "who": "metan",
          "text": "だから TTL、つまり結果の有効期限を決めて、古くなった結果は捨てるの。",
          "pause": 0.6
        },
        {
          "who": "metan",
          "text": "音声は、VOICEVOX の四国めたんと、ずんだもんでした。"
        }
      ]
    }
  ]
}
